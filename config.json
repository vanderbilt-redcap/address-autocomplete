{
	"name": "Address Autocompletion",

	"namespace": "Vanderbilt\\AddressExternalModule",

	"description": "This module takes address coordinates from fields specified and autocompletes a street address. Requires a Google API key and an https connection.",

	"authors": [
	  {
		"name": "Scott J. Pearson",
		"email": "datacore@vumc.org",
		"institution": "Vanderbilt University Medical Center"
	  },
	  {
		"name": "Mark McEver",
		"email": "datacore@vumc.org",
		"institution": "Vanderbilt University Medical Center"
	  },
	  {
		"name": "Kyle McGuffin",
		"email": "datacore@vumc.org",
		"institution": "Vanderbilt University Medical Center"
	  }
	],

	"permissions": [
		"hook_data_entry_form",
		"hook_survey_page"
	],

	"links": {
	},

	"project-settings": [
		{
			"key": "google-api-key",
			"name": "Google API Key",
			"required": true,
			"type": "text"
		},
		{
			"key": "autocomplete",
			"name": "Autocomplete Field (text only)",
			"required": true,
			"type": "field-list",
			"repeatable": false,
			"autocomplete": true
		},
		{
			"key": "street-number",
			"name": "Street Number Field",
			"required": false,
			"type": "field-list",
			"repeatable": false,
			"autocomplete": true
		},
		{
			"key": "street",
			"name": "Street Field",
			"required": false,
			"type": "field-list",
			"repeatable": false,
			"autocomplete": true
		},
		{
			"key": "city",
			"name": "City Field",
			"required": false,
			"type": "field-list",
			"repeatable": false,
			"autocomplete": true
		},
		{
			"key": "county",
			"name": "County Field",
			"required": false,
			"type": "field-list",
			"repeatable": false,
			"autocomplete": true
		},
		{
			"key": "state",
			"name": "State Field",
			"required": false,
			"type": "field-list",
			"repeatable": false,
			"autocomplete": true
		},
		{
			"key": "zip",
			"name": "Zip Code Field",
			"required": false,
			"type": "field-list",
			"repeatable": false,
			"autocomplete": true
		},
		{
			"key": "country",
			"name": "Country Field",
			"required": false,
			"type": "field-list",
			"repeatable": false,
			"autocomplete": true
		},
		{
			"key": "latitude",
			"name": "Latitude Field",
			"required": false,
			"type": "field-list",
			"repeatable": false,
			"autocomplete": true
		},
		{
			"key": "longitude",
			"name": "Longitude Field",
			"required": false,
			"type": "field-list",
			"repeatable": false,
			"autocomplete": true
		},
		{
			"key": "place-name",
			"name": "Place Name Field",
			"required": false,
			"type": "field-list",
			"repeatable": false,
			"autocomplete": true
		},
		{
			"key": "recover-unit-from-input",
			"name": "Recover unit/apartment number from typed text<br><span class='fs11'>Google often omits the <i>subpremise</i> component for Australian unit addresses, so <b>3/27 Harris St</b> is returned as street number <b>27</b> and the unit is lost. When enabled, the unit is parsed from what the user typed and prepended to the Street Number Field as <b>3/27</b>.<br>Requires <b>Street Number Field</b> to be mapped, and that field must have <b>no</b> integer/number validation.</span>",
			"required": false,
			"type": "checkbox",
			"repeatable": false
		},
		{
			"key": "included-region-codes",
			"name": "Restrict predictions to region codes<br><span class='fs11'>Optional comma-separated CLDR region codes, e.g. <b>au</b> (maximum 15). Leave blank for no restriction.</span>",
			"required": false,
			"type": "text"
		},
		{
			"key": "included-primary-types",
			"name": "Restrict predictions to place types<br><span class='fs11'>Optional comma-separated Google place types from Place Type tables A and B, e.g. <b>street_address,premise,subpremise</b> (maximum 5). Leave blank for no restriction. Verify in the browser console that predictions still appear after setting this.</span>",
			"required": false,
			"type": "text"
		},
		{
			"key": "import-google-api",
			"name": "Import Google API",
			"required": false,
			"type": "checkbox",
			"repeatable": false
		}
	]
}
